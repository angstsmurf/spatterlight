<!--
  Probe game for run_autosave_tests.py (Quest 5 half): the questions a game
  asks before its first turn.  The start script rolls a number, pauses for
  a key (`wait`), asks for a name (`get input`), then a gender (`show menu`), then (as an expression,
  which blocks inside the script) whether that is right.  The pause and
  each prompt autosave as a record of the answers given so far, and the relaunch boots
  again with those answers up to the prompt it was closed on.  `who` shows
  that the answers and the number arrived.

  Not a fixture: nothing globs this directory.
-->
<asl version="580">
  <include ref="English.aslx" />
  <include ref="Core.aslx" />
  <game name="Autosave Intro Probe">
    <gameid>a7c1f0c2-5a51-4c58-9d0e-3b1f6a2e9d11</gameid>
    <version>1.0</version>
    <firstpublished>2026</firstpublished>
    <lucky type="int">0</lucky>
    <who>nobody</who>
    <gender>unknown</gender>
    <sure type="boolean">false</sure>
    <start type="script">
      game.lucky = GetRandomInt(1, 1000)
      wait {
        msg ("What is your name?")
        get input {
          game.who = result
          msg ("Hello, " + result + ".")
          options = Split("male;female", ";")
          show menu ("Are you male or female?", options, false) {
            game.gender = result
            game.sure = Ask("Is that right?")
            msg ("Welcome.")
          }
        }
      }
    </start>
  </game>
  <object name="hall">
    <inherit name="editor_room" />
    <description>A hall.</description>
    <object name="player">
      <inherit name="editor_player" />
    </object>
  </object>
  <command name="whocmd">
    <pattern>who</pattern>
    <script>
      msg ("You are " + game.who + ", " + game.gender + ", sure " + game.sure + ", lucky number " + game.lucky + ".")
    </script>
  </command>
</asl>
