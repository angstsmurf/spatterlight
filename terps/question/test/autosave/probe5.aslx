<!-- Probe game for run_autosave_tests.py (Quest 5 half).  Two rooms on the
     Core library, and one command per piece of state the Spatterlight
     autosave has to carry across a relaunch:

       roll    the RNG position (GetRandomInt under determinism)
       count   a game attribute
       pulse   a recurring <timer> (every 3 seconds; the Glk frontend counts
               one second per timer event, and arms the timer only with the
               sa_delays setting on)
       hold    a one-shot SetTimeout (5 seconds)
       type    `get input`  : the prompts a game can be closed on.  None of
       pick    `show menu`    them autosaves: the relaunch resumes at the
       query   `ask`          parser prompt before them and the command is
       nap     `wait`         typed again.

     The room description names the apple through a hyperlink (Core's
     default); clicking it pops the object's verb menu, which DOES stay
     autosaved so a relaunch reopens into the menu.

     Not a fixture: nothing globs this directory. -->
<asl version="580">
  <include ref="English.aslx" />
  <include ref="Core.aslx" />

  <game name="Autosave Probe">
    <gameid>a0705a7e-5a7e-4000-8000-000000000005</gameid>
    <author>Question test suite</author>
    <count type="int">0</count>
  </game>

  <object name="lounge">
    <inherit name="editor_room" />
    <description>A lounge. The garden is north.</description>
    <object name="player">
      <inherit name="editor_player" />
    </object>
    <object name="apple">
      <inherit name="editor_object" />
      <take />
    </object>
    <object name="chest">
      <inherit name="editor_object" />
      <inherit name="openable" />
    </object>
    <exit alias="north" to="garden">
      <inherit name="northdirection" />
    </exit>
  </object>

  <object name="garden">
    <inherit name="editor_room" />
    <description>A garden. The lounge is south.</description>
    <object name="rose">
      <inherit name="editor_object" />
    </object>
    <exit alias="south" to="lounge">
      <inherit name="southdirection" />
    </exit>
  </object>

  <timer name="pulse">
    <interval type="int">3</interval>
    <enabled type="boolean">true</enabled>
    <script>
      msg ("[pulse]")
    </script>
  </timer>

  <command name="rollcmd">
    <pattern>roll</pattern>
    <script>
      msg ("You roll " + GetRandomInt(1, 1000) + ".")
    </script>
  </command>
  <command name="countcmd">
    <pattern>count</pattern>
    <script>
      game.count = game.count + 1
      msg ("Count is " + game.count + ".")
    </script>
  </command>
  <command name="holdcmd">
    <pattern>hold</pattern>
    <script>
      msg ("Holding.")
      SetTimeout (5) {
        msg ("[timeout]")
      }
    </script>
  </command>
  <command name="typecmd">
    <pattern>type</pattern>
    <script>
      get input {
        msg ("You typed " + result + ".")
      }
    </script>
  </command>
  <command name="pickcmd">
    <pattern>pick</pattern>
    <script>
      options = Split("red;green;blue", ";")
      show menu ("Pick a colour", options, false) {
        msg ("You picked " + result + ".")
      }
    </script>
  </command>
  <command name="querycmd">
    <pattern>query</pattern>
    <script>
      ask ("Are you sure?") {
        if (result) {
          msg ("Confirmed.")
        }
        else {
          msg ("Denied.")
        }
      }
    </script>
  </command>
  <command name="napcmd">
    <pattern>nap</pattern>
    <script>
      wait {
        msg ("You wake up.")
      }
    </script>
  </command>
</asl>
