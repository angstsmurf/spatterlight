<Value>LocationLab</Value>
</Property>
<LastUpdated>2026-07-09 22:40:00</LastUpdated>
<Created>2026-07-09 22:40:00</Created>
</Character>

<!-- Results of pop-up functions, set via task actions (ADRIFT's usual pattern). -->
<Variable>
<Key>ChoiceResult</Key>
<Name>ChoiceResult</Name>
<Type>Text</Type>
<InitialValue>unset</InitialValue>
<LastUpdated>2026-07-09 22:40:00</LastUpdated>
<Created>2026-07-09 22:40:00</Created>
</Variable>
<Variable>
<Key>InputResult</Key>
<Name>InputResult</Name>
<Type>Text</Type>
<InitialValue>unset</InitialValue>
<LastUpdated>2026-07-09 22:40:00</LastUpdated>
<Created>2026-07-09 22:40:00</Created>
</Variable>
<Variable>
<Key>InputNoDefault</Key>
<Name>InputNoDefault</Name>
<Type>Text</Type>
<InitialValue>unset</InitialValue>
<LastUpdated>2026-07-09 22:40:00</LastUpdated>
<Created>2026-07-09 22:40:00</Created>
</Variable>

<Task>
<Key>TaskHelp</Key>
<Priority>50000</Priority>
<Type>General</Type>
<Command>help</Command>
<Description>List popup test commands</Description>
<CompletionMessage>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Commands: ask choice, ask name, ask blank, show results.</Text>
</Description>
</CompletionMessage>
<Repeatable>1</Repeatable>
<LastUpdated>2026-07-09 22:40:00</LastUpdated>
<Created>2026-07-09 22:40:00</Created>
</Task>

<!-- SetVariable via PopUpChoice — same pattern ADRIFT uses for player gender prompts. -->
<Task>
<Key>TaskAskChoice</Key>
<Priority>50001</Priority>
<Type>General</Type>
<Command>ask choice</Command>
<Description>PopUpChoice into ChoiceResult</Description>
<MessageBeforeOrAfter>After</MessageBeforeOrAfter>
<CompletionMessage>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Choice stored. ChoiceResult=%ChoiceResult%.</Text>
</Description>
</CompletionMessage>
<Actions>
<SetVariable>ChoiceResult = %PopUpChoice["Pick a colour", "red", "blue"]%</SetVariable>
</Actions>
<Repeatable>1</Repeatable>
<LastUpdated>2026-07-09 22:40:00</LastUpdated>
<Created>2026-07-09 22:40:00</Created>
</Task>

<!-- SetVariable via PopUpInput with default — same pattern as player name prompts. -->
<Task>
<Key>TaskAskName</Key>
<Priority>50002</Priority>
<Type>General</Type>
<Command>ask name</Command>
<Description>PopUpInput into InputResult</Description>
<MessageBeforeOrAfter>After</MessageBeforeOrAfter>
<CompletionMessage>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Name stored. InputResult=%InputResult%.</Text>
</Description>
</CompletionMessage>
<Actions>
<SetVariable>InputResult = %PopUpInput["Please enter your name", "Anonymous"]%</SetVariable>
</Actions>
<Repeatable>1</Repeatable>
<LastUpdated>2026-07-09 22:40:00</LastUpdated>
<Created>2026-07-09 22:40:00</Created>
</Task>

<!-- PopUpInput with prompt only (no default). -->
<Task>
<Key>TaskAskBlank</Key>
<Priority>50003</Priority>
<Type>General</Type>
<Command>ask blank</Command>
<Description>PopUpInput with no default</Description>
<MessageBeforeOrAfter>After</MessageBeforeOrAfter>
<CompletionMessage>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Blank input stored. InputNoDefault=%InputNoDefault%.</Text>
</Description>
</CompletionMessage>
<Actions>
<SetVariable>InputNoDefault = %PopUpInput["Type anything"]%</SetVariable>
</Actions>
<Repeatable>1</Repeatable>
<LastUpdated>2026-07-09 22:40:00</LastUpdated>
<Created>2026-07-09 22:40:00</Created>
</Task>

<Task>
<Key>TaskShowResults</Key>
<Priority>50004</Priority>
<Type>General</Type>
<Command>show results</Command>
<Description>Show stored popup results</Description>
<CompletionMessage>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>ChoiceResult=%ChoiceResult%. InputResult=%InputResult%. InputNoDefault=%InputNoDefault%.</Text>
</Description>
</CompletionMessage>
<Repeatable>1</Repeatable>
<LastUpdated>2026-07-09 22:40:00</LastUpdated>
<Created>2026-07-09 22:40:00</Created>
</Task>

</Adventure>
