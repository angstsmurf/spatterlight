<Title>Popups Test</Title>
<Author>Test</Author>
<Introduction>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>This game exercises ADRIFT interactive pop-up functions: %PopUpChoice% and %PopUpInput%. Type help for commands.</Text>
</Description>
</Introduction>
<ShowFirstLocation>1</ShowFirstLocation>
<ShowExits>1</ShowExits>
<EnableMenu>1</EnableMenu>

<Location>
<Key>LocationLab</Key>
<ShortDescription>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Popup Lab</Text>
</Description>
</ShortDescription>
<LongDescription>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>A quiet room for testing pop-up choice and input functions.</Text>
</Description>
</LongDescription>
<LastUpdated>2026-07-09 22:40:00</LastUpdated>
<Created>2026-07-09 22:40:00</Created>
</Location>

<Character>
<Key>Player</Key>
<Name>Player</Name>
<Article />
<Prefix />
