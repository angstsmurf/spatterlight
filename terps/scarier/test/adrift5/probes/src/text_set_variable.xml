<!-- Mirrors Skybreak PressS / PressS1: two %text% tasks gated by a numeric flag.
     The first task sets Named = "1" while a text reference is active; that literal
     must not be replaced by the typed text (the bug that caused the naming loop). -->
<Task>
<Key>NamePlayer</Key>
<Priority>1</Priority>
<Type>General</Type>
<Command>%text%</Command>
<Description>name player</Description>
<CompletionMessage>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>PLEASE NAME YOUR SHIP</Text>
</Description>
</CompletionMessage>
<Repeatable>1</Repeatable>
<Restrictions>
<Restriction>
<Variable>Named Must BeEqualTo 0</Variable>
</Restriction>
<BracketSequence>#</BracketSequence>
</Restrictions>
<Actions>
<SetVariable>Playername = "UCASE(%text%)"</SetVariable>
<SetVariable>Named = "1"</SetVariable>
</Actions>
<LastUpdated>2026-07-10 20:00:00</LastUpdated>
<Created>2026-07-10 20:00:00</Created>
</Task>
<Task>
<Key>NameShip</Key>
<Priority>2</Priority>
<Type>General</Type>
<Command>%text%</Command>
<Description>name ship</Description>
<CompletionMessage>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>COMMANDER IDENTIFIED AS %Playername%. SHIP IS %Shipname%.</Text>
</Description>
</CompletionMessage>
<Repeatable>1</Repeatable>
<MessageBeforeOrAfter>After</MessageBeforeOrAfter>
<Restrictions>
<Restriction>
<Variable>Named Must BeEqualTo 1</Variable>
</Restriction>
<BracketSequence>#</BracketSequence>
</Restrictions>
<Actions>
<SetVariable>Shipname = "UCASE(%text%)"</SetVariable>
<IncVariable>Named = "1"</IncVariable>
</Actions>
<LastUpdated>2026-07-10 20:00:00</LastUpdated>
<Created>2026-07-10 20:00:00</Created>
</Task>
