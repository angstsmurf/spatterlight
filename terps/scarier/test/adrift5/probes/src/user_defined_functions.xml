<!-- Zero-argument UDF. -->
<Function>
<Key>FunGreeting</Key>
<Name>Greeting</Name>
<Output>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Hello from Greeting UDF.</Text>
</Description>
</Output>
<LastUpdated>2026-07-09 21:00:00</LastUpdated>
<Created>2026-07-09 21:00:00</Created>
</Function>

<!-- Text argument: %Echo[hello]% -->
<Function>
<Key>FunEcho</Key>
<Name>Echo</Name>
<Output>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Echo says: %msg%</Text>
</Description>
</Output>
<Argument>
<Name>msg</Name>
<Type>Text</Type>
</Argument>
<LastUpdated>2026-07-09 21:00:00</LastUpdated>
<Created>2026-07-09 21:00:00</Created>
</Function>

<!-- Number argument, with arithmetic in the output. -->
<Function>
<Key>FunDouble</Key>
<Name>Double</Name>
<Output>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Double of %n% is &lt;# %n% * 2 #&gt;.</Text>
</Description>
</Output>
<Argument>
<Name>n</Name>
<Type>Number</Type>
</Argument>
<LastUpdated>2026-07-09 21:00:00</LastUpdated>
<Created>2026-07-09 21:00:00</Created>
</Function>

