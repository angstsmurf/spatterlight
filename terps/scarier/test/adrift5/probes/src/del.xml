<Task>
<Key>TaskFlushedStyle</Key>
<Priority>50002</Priority>
<Type>General</Type>
<Command>flushed style</Command>
<Description>Delete after a style boundary (in-buffer across marks)</Description>
<CompletionMessage>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Flushed style: a + bold x + del -- expect a (in-buffer delete across style marks)
Result: [a&lt;b&gt;x&lt;/b&gt;&lt;del&gt;]</Text>
</Description>
</CompletionMessage>
<Repeatable>1</Repeatable>
