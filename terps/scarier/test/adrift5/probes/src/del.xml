<Task>
<Key>TaskFlushedBr</Key>
<Priority>50003</Priority>
<Type>General</Type>
<Command>flushed br</Command>
<Description>Delete after a line break (in-buffer newline removal)</Description>
<CompletionMessage>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Flushed br: a + br + del -- expect a (newline removed in-buffer)
Result: [a&lt;br&gt;&lt;del&gt;]</Text>
</Description>
</CompletionMessage>
<Repeatable>1</Repeatable>
<LastUpdated>2026-07-12 11:40:00</LastUpdated>
<Created>2026-07-12 11:40:00</Created>
</Task>

<!-- Parent message ends 8[aZ (no trailing newline); Execute-Task child is only
     three del tags then ]END8.  pSpace joins with two spaces; the dels eat
     Z and those spaces (Runner whole-turn backspace). -->
<Task>
<Key>TaskCrossDel</Key>
<Priority>50004</Priority>
<Type>System</Type>
<Description>Cross-message del child</Description>
<CompletionMessage>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>&lt;del&gt;&lt;del&gt;&lt;del&gt;]END8</Text>
</Description>
</CompletionMessage>
<Repeatable>1</Repeatable>
<LastUpdated>2026-07-12 11:40:00</LastUpdated>
<Created>2026-07-12 11:40:00</Created>
</Task>

<Task>
<Key>TaskCross</Key>
<Priority>50005</Priority>
<Type>General</Type>
<Command>cross</Command>
<Description>Delete across a message boundary via Execute Task</Description>
<CompletionMessage>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Cross-message: parent 8[aZ + child three dels -- expect 8[a]END8
Result: 8[aZ</Text>
</Description>
</CompletionMessage>
<Actions>
<SetTasks>Execute TaskCrossDel</SetTasks>
</Actions>
<Repeatable>1</Repeatable>
<LastUpdated>2026-07-12 11:40:00</LastUpdated>
