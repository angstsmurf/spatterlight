<!-- Immediately: DisplayMessage from start, then from last sub-event, then before end. -->
<Event>
<Key>EvtImmediate</Key>
<Description>Immediate ticker</Description>
<Type>TurnBased</Type>
<WhenStart>Immediately</WhenStart>
<Length>3</Length>
<SubEvent>
<When>1 FromStartOfEvent</When>
<What>DisplayMessage</What>
<Measure>Turns</Measure>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Immediate event: message from start.</Text>
</Description>
</Action>
<OnlyApplyAt>Location1</OnlyApplyAt>
</SubEvent>
<SubEvent>
<When>1 FromLastSubEvent</When>
<What>DisplayMessage</What>
<Measure>Turns</Measure>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Immediate event: message from last sub-event.</Text>
</Description>
</Action>
<OnlyApplyAt>Location1</OnlyApplyAt>
</SubEvent>
<SubEvent>
<When>0 BeforeEndOfEvent</When>
<What>DisplayMessage</What>
<Measure>Turns</Measure>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Immediate event: message before end.</Text>
</Description>
</Action>
<OnlyApplyAt>Location1</OnlyApplyAt>
</SubEvent>
<LastUpdated>2026-07-09 19:00:00</LastUpdated>
<Created>2026-07-09 19:00:00</Created>
</Event>

<!-- BetweenXandYTurns: countdown via StartDelay, then run. -->
<Event>
<Key>EvtDelayed</Key>
<Description>Delayed starter</Description>
<Type>TurnBased</Type>
<WhenStart>BetweenXandYTurns</WhenStart>
<StartDelay>2</StartDelay>
<Length>2</Length>
<SubEvent>
<When>0 FromStartOfEvent</When>
<What>DisplayMessage</What>
<Measure>Turns</Measure>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Delayed event has started.</Text>
</Description>
</Action>
<OnlyApplyAt>Location1</OnlyApplyAt>
</SubEvent>
<SubEvent>
<When>0 BeforeEndOfEvent</When>
<What>DisplayMessage</What>
<Measure>Turns</Measure>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Delayed event is ending.</Text>
</Description>
</Action>
<OnlyApplyAt>Location1</OnlyApplyAt>
</SubEvent>
<LastUpdated>2026-07-09 19:00:00</LastUpdated>
<Created>2026-07-09 19:00:00</Created>
</Event>

<!-- AfterATask + ExecuteTask. -->
<Event>
<Key>EvtAfterTask</Key>
<Description>After-task runner</Description>
<Type>TurnBased</Type>
<WhenStart>AfterATask</WhenStart>
<Length>3</Length>
<Control>Start Completion TaskStartAfter</Control>
<SubEvent>
<When>1 FromStartOfEvent</When>
<What>ExecuteTask</What>
<Measure>Turns</Measure>
<Action>ExecuteTask TaskFromEvent</Action>
</SubEvent>
<SubEvent>
<When>0 FromLastSubEvent</When>
<What>DisplayMessage</What>
<Measure>Turns</Measure>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>After-task event: displayed right after ExecuteTask.</Text>
</Description>
</Action>
<OnlyApplyAt>Location1</OnlyApplyAt>
</SubEvent>
<SubEvent>
<When>0 BeforeEndOfEvent</When>
<What>DisplayMessage</What>
<Measure>Turns</Measure>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>After-task event finished.</Text>
</Description>
</Action>
<OnlyApplyAt>Location1</OnlyApplyAt>
</SubEvent>
<LastUpdated>2026-07-09 19:00:00</LastUpdated>
<Created>2026-07-09 19:00:00</Created>
</Event>

<!-- SetLook pushes onto the room description stack while the event runs. -->
<Event>
<Key>EvtSetLook</Key>
<Description>SetLook mist</Description>
<Type>TurnBased</Type>
<WhenStart>AfterATask</WhenStart>
<Length>4</Length>
<Control>Start Completion TaskStartLook</Control>
<SubEvent>
<When>0 FromStartOfEvent</When>
<What>SetLook</What>
<Measure>Turns</Measure>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>The lab is filled with swirling mist.</Text>
</Description>
</Action>
<OnlyApplyAt>Location1</OnlyApplyAt>
</SubEvent>
<SubEvent>
<When>2 FromStartOfEvent</When>
<What>DisplayMessage</What>
<Measure>Turns</Measure>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>The mist thickens for a moment.</Text>
</Description>
</Action>
<OnlyApplyAt>Location1</OnlyApplyAt>
</SubEvent>
<LastUpdated>2026-07-09 19:00:00</LastUpdated>
<Created>2026-07-09 19:00:00</Created>
</Event>

<!-- UnsetTask clears a previously completed task. -->
<Event>
<Key>EvtUnset</Key>
<Description>Unset marker</Description>
<Type>TurnBased</Type>
<WhenStart>AfterATask</WhenStart>
<Length>2</Length>
<Control>Start Completion TaskStartUnset</Control>
<SubEvent>
<When>1 FromStartOfEvent</When>
<What>UnsetTask</What>
<Measure>Turns</Measure>
<Action>UnsetTask TaskMarker</Action>
</SubEvent>
<SubEvent>
<When>0 FromLastSubEvent</When>
<What>DisplayMessage</What>
<Measure>Turns</Measure>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Unset event cleared the marker task.</Text>
</Description>
</Action>
<OnlyApplyAt>Location1</OnlyApplyAt>
</SubEvent>
<LastUpdated>2026-07-09 19:00:00</LastUpdated>
<Created>2026-07-09 19:00:00</Created>
</Event>

<!-- Starts when TaskMarker is unset via task action (UnCompletion control). -->
<Event>
<Key>EvtOnUncomplete</Key>
<Description>React to marker unset</Description>
<Type>TurnBased</Type>
<WhenStart>AfterATask</WhenStart>
<Length>1</Length>
<Control>Start UnCompletion TaskMarker</Control>
<SubEvent>
<When>0 FromStartOfEvent</When>
<What>DisplayMessage</What>
<Measure>Turns</Measure>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>UnCompletion control started this event.</Text>
</Description>
</Action>
<OnlyApplyAt>Location1</OnlyApplyAt>
</SubEvent>
<LastUpdated>2026-07-09 19:00:00</LastUpdated>
<Created>2026-07-09 19:00:00</Created>
</Event>

<!-- Start / Suspend / Resume / Stop via task completion controls. -->
<Event>
<Key>EvtControls</Key>
<Description>Controllable pulse</Description>
<Type>TurnBased</Type>
<WhenStart>AfterATask</WhenStart>
<Length>8</Length>
<Control>Start Completion TaskStartCtrl</Control>
<Control>Suspend Completion TaskPauseCtrl</Control>
<Control>Resume Completion TaskResumeCtrl</Control>
<Control>Stop Completion TaskStopCtrl</Control>
<SubEvent>
<When>1 FromStartOfEvent</When>
<What>DisplayMessage</What>
<Measure>Turns</Measure>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Control event: beat 1.</Text>
</Description>
</Action>
<OnlyApplyAt>Location1</OnlyApplyAt>
</SubEvent>
<SubEvent>
<When>2 FromStartOfEvent</When>
<What>DisplayMessage</What>
<Measure>Turns</Measure>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Control event: beat 2.</Text>
</Description>
</Action>
<OnlyApplyAt>Location1</OnlyApplyAt>
</SubEvent>
<SubEvent>
<When>3 FromStartOfEvent</When>
<What>DisplayMessage</What>
<Measure>Turns</Measure>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Control event: beat 3.</Text>
</Description>
</Action>
<OnlyApplyAt>Location1</OnlyApplyAt>
</SubEvent>
<SubEvent>
<When>4 FromStartOfEvent</When>
<What>DisplayMessage</What>
<Measure>Turns</Measure>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Control event: beat 4.</Text>
</Description>
</Action>
<OnlyApplyAt>Location1</OnlyApplyAt>
</SubEvent>
<LastUpdated>2026-07-09 19:00:00</LastUpdated>
<Created>2026-07-09 19:00:00</Created>
</Event>

