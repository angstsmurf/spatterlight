<!-- The srcs are the author's absolute Windows paths, as the Generator writes
     them; a raw .taf has no FileMappings, so a host finds oof.wav and oof.mp3
     beside the game by the path's last component.  The tag shapes are the
     corpus's most common: channel=1 loop=N, a bare channel=2, loop=Y, and a
     channel-specific stop. -->
<Task>
<Key>TaskWav</Key>
<Priority>50000</Priority>
<Type>General</Type>
<Command>wav</Command>
<Description>Play the WAV on channel 1</Description>
<CompletionMessage>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Playing the WAV on channel 1.
&lt;audio play src="C:\Users\Author\Documents\ADRIFT\Sound Test\oof.wav" channel=1 loop=N&gt;
That was the WAV.</Text>
</Description>
</CompletionMessage>
<Repeatable>1</Repeatable>
<LastUpdated>2026-10-07 13:00:00</LastUpdated>
<Created>2026-10-07 13:00:00</Created>
</Task>

