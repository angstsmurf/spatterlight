<Task>
<Key>TaskReveal</Key>
<Priority>60001</Priority>
<Type>General</Type>
<Command>reveal</Command>
<Description>Reveal main map rooms</Description>
<CompletionMessage>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Revealed Main-page demo rooms (returned to Hub). Expect Cellar-East dotted (started blocked) and Wide-South solid (started passable). Still unseen: Outside, Sky, Pit, Vault, Fog, Hidden Unseen, Offgrid, and Annex off-page rooms. Use REVEAL ANNEX for Annex.</Text>
</Description>
</CompletionMessage>
<Actions>
<MoveCharacter>Character Player ToLocation LocationNorth</MoveCharacter>
<MoveCharacter>Character Player ToLocation LocationTrap</MoveCharacter>
<MoveCharacter>Character Player ToLocation LocationSkewed</MoveCharacter>
<MoveCharacter>Character Player ToLocation LocationCellar</MoveCharacter>
<!-- Door starts closed: fail East once so bEverBeenBlocked is set → dotted after open. -->
<MoveCharacter>Character Player InDirection East</MoveCharacter>
<MoveCharacter>Character Player ToLocation LocationDoor</MoveCharacter>
<SetVariable>VariableDoor = "1"</SetVariable>
<MoveCharacter>Character Player ToLocation LocationAttic</MoveCharacter>
<MoveCharacter>Character Player ToLocation LocationCloset</MoveCharacter>
<MoveCharacter>Character Player ToLocation LocationOneWay</MoveCharacter>
<MoveCharacter>Character Player ToLocation LocationNoLink</MoveCharacter>
<MoveCharacter>Character Player ToLocation LocationWide</MoveCharacter>
<!-- Latch starts open: visit both ends without failing → solid after reveal. -->
<MoveCharacter>Character Player ToLocation LocationLatch</MoveCharacter>
<MoveCharacter>Character Player ToLocation LocationLoop</MoveCharacter>
<MoveCharacter>Character Player ToLocation LocationDisagree</MoveCharacter>
<MoveCharacter>Character Player ToLocation LocationHiddenSeen</MoveCharacter>
<MoveCharacter>Character Player ToLocation LocationHub</MoveCharacter>
</Actions>
<Repeatable>1</Repeatable>
</Task>

