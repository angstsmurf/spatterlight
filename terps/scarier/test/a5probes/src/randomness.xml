<!-- Event FromTo: ranged StartDelay, fixed Length. -->
<Event>
<Key>EvtDelayed</Key>
<Description>Delayed boom</Description>
<Type>TurnBased</Type>
<WhenStart>BetweenXandYTurns</WhenStart>
<StartDelay>1 to 2</StartDelay>
<Length>1</Length>
<SubEvent>
<When>0 FromStartOfEvent</When>
<What>DisplayMessage</What>
<Measure>Turns</Measure>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Delayed boom!</Text>
</Description>
</Action>
<OnlyApplyAt>LocationHub</OnlyApplyAt>
</SubEvent>
<LastUpdated>2026-07-10 22:00:00</LastUpdated>
<Created>2026-07-10 22:00:00</Created>
</Event>

<Task>
<Key>TaskRoll</Key>
<Priority>10</Priority>
<Type>General</Type>
<Command>roll</Command>
<Description>Roll RAND(1,6)</Description>
<MessageBeforeOrAfter>After</MessageBeforeOrAfter>
<CompletionMessage>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>You rolled %Roll%.</Text>
</Description>
</CompletionMessage>
<Actions>
<SetVariable>Roll = "RAND(1,6)"</SetVariable>
</Actions>
<Repeatable>1</Repeatable>
<LastUpdated>2026-07-10 22:00:00</LastUpdated>
<Created>2026-07-10 22:00:00</Created>
</Task>

<Task>
<Key>TaskScatter</Key>
<Priority>20</Priority>
<Type>General</Type>
<Command>scatter</Command>
<Description>Scatter Bob into GroupWings</Description>
<CompletionMessage>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>You scatter Bob into a random wing.</Text>
</Description>
</CompletionMessage>
<Actions>
<MoveCharacter>Character CharacterBob ToLocationGroup GroupWings</MoveCharacter>
</Actions>
<Repeatable>1</Repeatable>
<LastUpdated>2026-07-10 22:00:00</LastUpdated>
<Created>2026-07-10 22:00:00</Created>
</Task>

