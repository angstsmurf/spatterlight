<Walk>
<Description>Scout wing patrol</Description>
<Loops>0</Loops>
<StartActive>1</StartActive>
<!-- Group destination + FromTo step length -->
<Step>GroupWings 1 to 2</Step>
<Activity>
<When>0 FromStartOfWalk</When>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Scout begins the wing patrol.</Text>
</Description>
</Action>
<OnlyApplyAt>AllLocations</OnlyApplyAt>
</Activity>
</Walk>
