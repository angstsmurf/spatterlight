<!-- TimeBased, starts immediately: wall-clock ticks with no player input. -->
<Event>
<Key>EvtImmediateTime</Key>
<Description>Immediate time ticker</Description>
<Type>TimeBased</Type>
<WhenStart>Immediately</WhenStart>
<Length>4</Length>
<SubEvent>
<When>1 FromStartOfEvent</When>
<What>DisplayMessage</What>
<Measure>Seconds</Measure>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>&lt;br&gt;Immediate time event: tick 1.</Text>
</Description>
</Action>
<OnlyApplyAt>Location1</OnlyApplyAt>
</SubEvent>
<SubEvent>
<When>2 FromStartOfEvent</When>
<What>DisplayMessage</What>
<Measure>Seconds</Measure>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>&lt;br&gt;Immediate time event: tick 2.</Text>
</Description>
</Action>
<OnlyApplyAt>Location1</OnlyApplyAt>
</SubEvent>
<SubEvent>
<When>3 FromStartOfEvent</When>
<What>ExecuteTask</What>
<Measure>Seconds</Measure>
<Action>ExecuteTask TaskFromTimer</Action>
</SubEvent>
<SubEvent>
<When>0 BeforeEndOfEvent</When>
<What>DisplayMessage</What>
<Measure>Seconds</Measure>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>&lt;br&gt;Immediate time event: ending.</Text>
</Description>
</Action>
<OnlyApplyAt>Location1</OnlyApplyAt>
</SubEvent>
<LastUpdated>2026-07-10 13:00:00</LastUpdated>
<Created>2026-07-10 13:00:00</Created>
</Event>

