<!-- Guard: StartActive walk West, Center, East with messages and ExecuteTask. -->
<Character>
<Key>CharacterGuard</Key>
<Name>Guard</Name>
<Article />
<Prefix />
<Descriptor>guard</Descriptor>
<Type>NonPlayer</Type>
<Description>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>A stern guard on patrol.</Text>
</Description>
</Description>
<Property>
<Key>CharacterPosition</Key>
<Value>Standing</Value>
</Property>
<Property>
<Key>CharacterLocation</Key>
<Value>At Location</Value>
</Property>
<Property>
<Key>CharacterAtLocation</Key>
<Value>LocationWest</Value>
</Property>
<Property>
<Key>Known</Key>
</Property>
<Property>
<Key>Gender</Key>
<Value>Male</Value>
</Property>
<Property>
<Key>ShowEnterExit</Key>
</Property>
<Property>
<Key>CharEnters</Key>
<Value>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>enters</Text>
</Description>
</Value>
</Property>
<Property>
<Key>CharExits</Key>
<Value>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>exits</Text>
</Description>
</Value>
</Property>
<Walk>
<Description>Guard StartActive patrol</Description>
<Loops>0</Loops>
<StartActive>1</StartActive>
<!-- At time 0: stay West. After 1 turn: Center. After 2: East. -->
<Step>LocationWest 1</Step>
<Step>LocationCenter 1</Step>
<Step>LocationEast 1</Step>
<Activity>
<When>1 FromStartOfWalk</When>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Walk activity: Guard is mid-patrol.</Text>
</Description>
</Action>
<OnlyApplyAt>AllLocations</OnlyApplyAt>
</Activity>
<Activity>
<When>2 FromStartOfWalk</When>
<Action>ExecuteTask TaskFromWalk</Action>
</Activity>
<Activity>
<When>0 BeforeEndOfWalk</When>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Walk activity: Guard patrol ending.</Text>
</Description>
</Action>
<OnlyApplyAt>AllLocations</OnlyApplyAt>
</Activity>
</Walk>
<LastUpdated>2026-07-09 20:00:00</LastUpdated>
<Created>2026-07-09 20:00:00</Created>
</Character>

<!-- Scout: controllable walk, ComesAcross, and UnCompletion start. -->
<Character>
<Key>CharacterScout</Key>
<Name>Scout</Name>
<Article />
<Prefix />
<Descriptor>scout</Descriptor>
<Type>NonPlayer</Type>
<Description>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>A restless scout.</Text>
</Description>
</Description>
<Property>
<Key>CharacterPosition</Key>
<Value>Standing</Value>
</Property>
<Property>
<Key>CharacterLocation</Key>
<Value>At Location</Value>
</Property>
<Property>
<Key>CharacterAtLocation</Key>
<Value>LocationEast</Value>
</Property>
<Property>
<Key>Known</Key>
</Property>
<Property>
<Key>Gender</Key>
<Value>Female</Value>
</Property>
<Property>
<Key>ShowEnterExit</Key>
</Property>
<Property>
<Key>CharEnters</Key>
<Value>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>enters</Text>
</Description>
</Value>
</Property>
<Property>
<Key>CharExits</Key>
<Value>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>exits</Text>
</Description>
</Value>
</Property>
<Walk>
<Description>Scout controllable patrol</Description>
<Loops>0</Loops>
<StartActive>0</StartActive>
<!-- time 0 East; then Center, West, Center, East -->
<Step>LocationEast 1</Step>
<Step>LocationCenter 1</Step>
<Step>LocationWest 1</Step>
<Step>LocationCenter 1</Step>
<Step>LocationEast 1</Step>
<Control>Start Completion TaskStartScout</Control>
<Control>Suspend Completion TaskPauseScout</Control>
<Control>Resume Completion TaskResumeScout</Control>
<Control>Stop Completion TaskStopScout</Control>
<Control>Start UnCompletion TaskScoutMarker</Control>
<Activity>
<When>ComesAcross %Player%</When>
<Action>ExecuteTask TaskScoutMet</Action>
</Activity>
<Activity>
<When>1 FromStartOfWalk</When>
<Action>
<Description>
<DisplayWhen>StartDescriptionWithThis</DisplayWhen>
<Text>Scout walk: beat after first step.</Text>
</Description>
</Action>
<OnlyApplyAt>AllLocations</OnlyApplyAt>
</Activity>
</Walk>
<LastUpdated>2026-07-09 20:00:00</LastUpdated>
<Created>2026-07-09 20:00:00</Created>
</Character>

