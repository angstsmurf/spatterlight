# make_sizeprobe.py writes the unobfuscated body beside every .taf it emits,
# for eyeballing the field stream when a probe misbehaves.
*.taf.plain
__pycache__/

# Sanitizer build artifacts from `make -f Makefile.headless sanitize`.
*_san
*_san.o
*.dSYM/

# Archives downloaded by fetch_games.sh on the way to the game corpora
# (see GAMES.md); the corpora themselves are ignored per-corpus.
/.game-cache/
